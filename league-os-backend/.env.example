JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Password reset email
FRONTEND_URL=http://localhost:4200
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Арман Лига <no-reply@example.com>"

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=league_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata

# Tournament engine rollout
TOURNAMENT_BUILDER_ENABLED=false
MULTI_STAGE_PUBLIC_VIEW_ENABLED=false

# VK news announcements. Server-only user token authorized for wall/photos publishing.
# Never put this token into Angular environment files or commit the real .env.
VK_PUBLISHING_ENABLED=false
VK_NEWS_COMMUNITY_ID=
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
# Production compose sets this internal URL automatically.
NEWS_HTML_TEMPLATE_URL=http://frontend/index.html
